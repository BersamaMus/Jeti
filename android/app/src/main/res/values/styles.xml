<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Jeti is always dark, whatever the system's setting. -->
    <!-- While the process starts, until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/jeti_background</item>
    </style>
</resources>
